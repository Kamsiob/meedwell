<?xml version="1.0" encoding="utf-8"?>
<!--
  Two permissions in version one, both narrow, both explained in Meedwell's own
  words before Android's dialog appears. Nothing else is declared here, and the
  merged manifest is audited after every dependency addition, because libraries
  introduce permissions silently.

  Deliberately absent, and they stay absent:
    - RECORD_AUDIO. The waveform comes from a custom AudioProcessor tap inside
      Meedwell's own Media3 pipeline, never the Visualizer API, which would
      require the microphone. There is a test that fails the build if this
      permission ever appears in the merged manifest.
    - ACCESS_FINE_LOCATION, READ_CONTACTS, and anything like them. Not ever.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only so the player appears in the shade and on the lock screen. That is
         the entire use. Meedwell never sends a notification about anything
         else, and there are no engagement notifications by design. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- READ_MEDIA_AUDIO was declared here and never once used.

         Local music reaches the shelf entirely through the Storage Access
         Framework: `LocalScanner` takes a persistable grant on the folder the
         user picked and reads it with `DocumentFile`. That path needs no
         runtime permission, so the declaration bought nothing and cost the one
         thing this app is arguing for. An app that asks for a media permission
         it never exercises has already lost the argument its Privacy screen is
         trying to make.

         The MediaStore download path in MASTER_SPEC section 4 was the original
         reason for it. It was never built, and it cannot be: verification found
         Bandcamp exposes no download endpoint. -->


    <!-- Streaming and syncing the collection. The only network peer is
         Bandcamp's own API server. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- The playback service goes foreground while something is playing, which
         is what keeps audio alive when the app is not on screen and what puts
         the player in the notification shade.

         Both are required from Android 14, and the typed one has to match the
         service's foregroundServiceType. Without them the app crashes the
         moment the service posts its notification, which is exactly what
         happened before they were added: playback started fine and then died
         on backgrounding. The manifest audit could not catch this, because its
         job is to fail on a permission that should not be here rather than to
         notice one that should. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- The Surroundings download service. `dataSync` is the honest type for
         fetching files somebody asked for, and it is what lets a download
         survive leaving the app. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:name=".MeedwellApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Meedwell">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:theme="@style/Theme.Meedwell">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>


        <!--
          The playback service. A MediaLibraryService rather than a plain
          MediaSessionService, which costs nothing now and is what makes Android
          Auto a small change later rather than a rewrite.

          foregroundServiceType mediaPlayback is required from Android 14, and
          without it a long run is killed on most phones.

          exported is true because the system media controls, the lock screen
          and Bluetooth media buttons all reach the session from outside the
          app. The intent filter is the only way in.
        -->
        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <!--
                  Media3 also matches on the session service action, and some
                  controllers look for that one rather than the library one.
                -->
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="android.media.browse.MediaBrowserService" />
                <!--
                  **Media buttons, which is how anything outside this app asks
                  for pause or next.**

                  Media3's own service declaration calls for this action and it
                  was missing. System media keys still worked, because the
                  platform routes those straight to the active session, and so
                  did the shade, because those buttons are our own pending
                  intents. What could not work was a third party controller, a
                  launcher's media widget or a car head unit, which resolve this
                  service by the media button action before sending anything.
                -->
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </service>

        <!-- Surroundings downloads.

             Not exported, and no intent filter: nothing outside the app has any
             business starting a download, and it is only ever reached by an
             explicit intent from this process.

             A foreground service because a download that stops the moment you
             leave the app is not a download. `dataSync` is the honest type for
             it: it is fetching files the user asked for, not playing media. -->
        <service
            android:name=".data.SurroundingsDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
          Holds a Surroundings bed up and gives it a notification. Media
          playback rather than dataSync: it is sound coming out of the phone.
        -->
        <service
            android:name=".playback.SurroundingsService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

    </application>

</manifest>
