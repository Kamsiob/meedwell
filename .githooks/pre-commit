#!/usr/bin/env bash
#
# Refuses a commit that carries anything credential shaped.
#
# The repository is public. A credential committed and then deleted is still a
# credential in the history, and history rewriting is forbidden by the project's
# own process rules. So the only real defence is never letting it in.
#
# Install once per clone:  git config core.hooksPath .githooks
#
set -euo pipefail

fail() { echo "pre-commit: $1"; echo "Nothing was committed."; exit 1; }

staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

# Files that should never be tracked at all, whatever they contain.
while IFS= read -r file; do
  case "$file" in
    *.jks|*.keystore|keystore.properties|local.properties|*.env|private/*)
      fail "$file is not something this repository may track." ;;
  esac
done <<< "$staged"

# Content that looks like a credential regardless of the file it sits in.
for file in $staged; do
  [ -f "$file" ] || continue
  case "$file" in *.png|*.jpg|*.jpeg|*.webp|*.ttf|*.jar|*.zip) continue ;; esac

  if grep -qE 'BEGIN [A-Z ]*PRIVATE KEY' "$file"; then
    fail "$file contains a private key."
  fi
  # A Subsonic password or generated username: a long unbroken run of upper
  # case letters and digits, which normal prose and code do not produce.
  if grep -qE '[A-Z0-9]{28,}' "$file"; then
    fail "$file contains a long uppercase token that looks like a Bandcamp Subsonic credential. If it is genuinely not one, rename or restructure it so this check can tell the difference."
  fi
done

echo "pre-commit: no credentials found in the staged changes."
